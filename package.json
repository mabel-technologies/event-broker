{
  "name": "@mabel-technologies/event-broker",
  "version": "1.1.0",
  "description": "Reusable event broker: SNS publish, SQS poll, re-emit via @tsed/event-emitter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm/index.d.ts",
      "default": "./dist/typeorm/index.js"
    },
    "./neo4j": {
      "types": "./dist/neo4j/index.d.ts",
      "default": "./dist/neo4j/index.js"
    },
    "./dynamo": {
      "types": "./dist/dynamo/index.d.ts",
      "default": "./dist/dynamo/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json",
    "./heartbeat": {
      "types": "./dist/heartbeat/index.d.ts",
      "default": "./dist/heartbeat/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mabel-technologies/event-broker.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:up": "bash .local/setup.sh",
    "local:down": "bash .local/teardown.sh",
    "local:filters": "bash .local/provision/sync-filters.sh",
    "local:ui": "bash .local/ui.sh",
    "local:ui:down": "bash .local/ui-down.sh",
    "test:floci": "AWS_ENDPOINT_URL=http://localhost:4566 AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_DEFAULT_REGION=us-east-1 vitest run --testTimeout=90000"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@tsed/di": "^8.0.0",
    "@tsed/event-emitter": "^8.0.0",
    "@tsed/logger": "^8.0.0",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "@tsed/core": ">=8.0.0",
    "typeorm": ">=0.3.20",
    "neo4j-driver": ">=5.0.0",
    "@aws-sdk/client-dynamodb": "^3.1137.0",
    "@aws-sdk/client-cloudwatch": "^3.1137.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "neo4j-driver": "^5.28.3",
    "typeorm": "^0.3.31",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "@aws-sdk/client-dynamodb": "^3.1137.0",
    "@aws-sdk/client-cloudwatch": "^3.1137.0"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    },
    "neo4j-driver": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-cloudwatch": {
      "optional": true
    }
  }
}
